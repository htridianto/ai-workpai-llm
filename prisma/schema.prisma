generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id              String             @id @default(cuid())
  name            String
  description     String?
  styleColor      String?            @map("style_color")
  createdAt       DateTime           @default(now()) @map("created_at")
  deletedAt       DateTime?          @map("deleted_at")
  users           WorkspaceUser[]
  folders         Folder[]
  files           File[]
  documentContexts DocumentContext[]

  @@map("workspaces")
}

model User {
  id              String             @id @default(uuid())
  name            String?            @map("display_name")
  email           String             @unique
  emailVerified   Int?               @default(0) @map("email_verified") // Boolean (0 = false, 1 = true)
  image           String?            @map("avatar_url")
  
  // Custom fields
  userName        String?            @unique @map("user_name")
  ssoAuthProvider String?            @map("sso_auth_provider")
  ssoAuthId       String?            @map("sso_auth_id")
  credential      String?            // Password hash
  bio             String?
  role            String             @default("default")
  createdAt       DateTime           @default(now()) @map("created_at")
  lastLoggedin    DateTime?          @map("last_loggedin")
  sessionToken    String?           @map("session_token")
  deletedAt       DateTime?          @map("deleted_at")
  workspaces      WorkspaceUser[]
  
  // NextAuth relations
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model WorkspaceUser {
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        String    @default("member")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("workspace_users")
}

model Folder {
  id              String             @id @default(cuid())
  name            String
  parentFolderId  String?            @map("parent_folder_id")
  workspaceId     String             @map("workspace_id")
  isSystem        Int                @default(0) @map("is_system") // Boolean (0 = false, 1 = true)
  createdAt       DateTime           @default(now()) @map("created_at")
  deletedAt       DateTime?          @map("deleted_at")
  
  parentFolder    Folder?            @relation("FolderToFolder", fields: [parentFolderId], references: [id], onDelete: SetNull)
  subFolders      Folder[]           @relation("FolderToFolder")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  files           File[]
  documentContexts DocumentContext[]

  @@index([workspaceId])
  @@map("folders")
}

model File {
  id              String             @id @default(cuid())
  name            String
  folderId        String?            @map("folder_id")
  workspaceId     String             @map("workspace_id")
  meta            String?            // Disimpan sebagai JSON string
  createdAt       DateTime           @default(now()) @map("created_at")
  deletedAt       DateTime?          @map("deleted_at")
  
  folder          Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentContexts DocumentContext[]

  @@index([folderId])
  @@map("files")
}

model DocumentContext {
  id          String    @id @default(cuid())
  fileId      String?   @map("file_id")
  type        String?   // CHECK(type IN ('file', 'link', 'whatsapp')) - Handled in logic or enum if supported
  workspaceId String    @map("workspace_id")
  folderId    String?   @map("folder_id")
  meta        String?   // Disimpan sebagai JSON string
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  file        File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("document_contexts")
}
