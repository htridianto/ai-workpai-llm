{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/",
        "destination": "/dashboard",
        "regex": "^/(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/dashboard/[workspaceId]",
      "regex": "^/dashboard/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/dashboard/(?<nxtPworkspaceId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/restapi/chatsession/[sessionId]",
      "regex": "^/restapi/chatsession/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsessionId": "nxtPsessionId"
      },
      "namedRegex": "^/restapi/chatsession/(?<nxtPsessionId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/restapi/workspaces/[workspaceId]",
      "regex": "^/restapi/workspaces/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPworkspaceId": "nxtPworkspaceId"
      },
      "namedRegex": "^/restapi/workspaces/(?<nxtPworkspaceId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/generated",
      "regex": "^/generated(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/generated(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/restapi/chat",
      "regex": "^/restapi/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/chat(?:/)?$"
    },
    {
      "page": "/restapi/chatsession",
      "regex": "^/restapi/chatsession(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/chatsession(?:/)?$"
    },
    {
      "page": "/restapi/login",
      "regex": "^/restapi/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/login(?:/)?$"
    },
    {
      "page": "/restapi/login/demo",
      "regex": "^/restapi/login/demo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/login/demo(?:/)?$"
    },
    {
      "page": "/restapi/login/google",
      "regex": "^/restapi/login/google(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/login/google(?:/)?$"
    },
    {
      "page": "/restapi/workspaces",
      "regex": "^/restapi/workspaces(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/restapi/workspaces(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    },
    {
      "page": "/workspaces",
      "regex": "^/workspaces(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workspaces(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}